#!/usr/bin/env bash
# Pre-commit privacy gate. Enable once per clone:  git config core.hooksPath .githooks
#
# Runs scripts/privacy_audit.py over what is staged (forbidden file types, placeholder-only emails,
# phone numbers, home paths, Office-document text and author fields). If a private denylist exists
# (default ~/.config/jobsearch-private/denylist.txt, or $JOBSEARCH_DENYLIST) it is applied too; it is
# optional and must live outside this repository.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

DENYLIST="${JOBSEARCH_DENYLIST:-$HOME/.config/jobsearch-private/denylist.txt}"
args=()
if [ -f "$DENYLIST" ]; then
  args+=(--denylist "$DENYLIST")
else
  echo "pre-commit: no private denylist at $DENYLIST (optional); running the generic checks only" >&2
fi

fail=0
python3 scripts/privacy_audit.py "${args[@]+"${args[@]}"}" >&2 || fail=1

# The author identity of the commit being made must be a noreply address.
email=$(git config user.email || true)
case "$email" in
  *@users.noreply.github.com|noreply@github.com) ;;
  *) echo "pre-commit: user.email must be a noreply address (got: ${email:-unset})" >&2; fail=1 ;;
esac

exit $fail
